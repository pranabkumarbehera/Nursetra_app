{
  "name": "Nursetra",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "adb uninstall com.nursetra && react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest",
    "delete": "adb uninstall com.nursetra",
    "debug-build": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res && cd android && gradlew assembleDebug && cd..",
    "release-build": "cd android && ./gradlew clean  && ./gradlew assembleRelease && cd ..",
    "adb-build": "adb uninstall com.nursetra && cd android && ./gradlew clean  && ./gradlew assembleRelease && cd .."
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native/new-app-screen": "0.84.0",
    "@react-navigation/bottom-tabs": "^7.16.2",
    "@react-navigation/native": "^7.2.5",
    "@react-navigation/native-stack": "^7.16.0",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.18.1",
    "react": "19.2.3",
    "react-native": "0.84.0",
    "react-native-device-info": "^15.0.2",
    "react-native-file-viewer": "^2.1.5",
    "react-native-fs": "^2.20.0",
    "react-native-gesture-handler": "^3.0.0",
    "react-native-image-crop-picker": "^0.51.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "react-native-shimmer-placeholder": "^2.0.9",
    "react-native-toast-message": "^2.4.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-webview": "^13.17.0",
    "react-redux": "^9.3.0",
    "redux": "^5.0.1",
    "redux-logger": "^3.0.6",
    "redux-saga": "^1.5.0",
    "sp-react-native-in-app-updates": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.84.0",
    "@react-native/eslint-config": "0.84.0",
    "@react-native/metro-config": "0.84.0",
    "@react-native/typescript-config": "0.84.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
